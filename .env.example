# Data Impulse residential proxy credentials (from your Data Impulse dashboard)
# Copy this file to .env and fill in your real values. Never commit .env.
PROXY_USER=your_dataimpulse_username
PROXY_PASS=your_dataimpulse_password

# Gateway (defaults shown; you normally do not need to change these)
PROXY_HOST=gw.dataimpulse.com
PROXY_PORT=823